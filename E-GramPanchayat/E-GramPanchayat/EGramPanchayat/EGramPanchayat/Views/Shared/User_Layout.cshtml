@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Beneficiary Zone</title>
    <link href="~/Content/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Content/js/bootstrap.min.js"></script>
    <script src="~/Content/js/jquery-3.7.1.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Saira:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/brands.min.css" integrity="sha512-8RxmFOVaKQe/xtg6lbscU9DU0IRhURWEuiI0tXevv+lXbAHfkpamD4VKFQRto9WgfOJDwOZ74c/s9Yesv3VvIQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Latest compiled JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        .nav-item {
            margin-left: 50px;
        }
        .navbar-expand-sm {
            background-color: rgba(8, 83, 137, 0.898);
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row" style="min-height:80px; background-color:darkorange; text-align: center; padding-top:20px;">
            <div class="col-sm-1">
                <img style="height:120px; width:150px; padding-bottom:20px;" src="~/Content/Images/eg1.png" />
            </div>
            <div class="col-sm-9">
                <h1 style="padding-top:20px; color:white">Welcome to User Zone</h1>
            </div>
            <div class="col-sm-2 text-center text-white" style="min-height: 120px;padding-top: 5px; border-radius:50%;">
                <img src="@ViewBag.PicFileName" height="80" width="80" id="upic" style="border-radius:70px ; border:1px solid black;" />
                <div id="uname">@ViewBag.Name</div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12" style="margin:0px;padding:0px;">
                <nav class="navbar navbar-expand-sm navbar-dark" >
                    <!-- Brand -->
                    <!-- Links -->
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="/User/Dashboard"><i class="bi bi-house-door"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="SearchSevices"><i class="bi bi-briefcase-fill"></i> View Services</a>
                        </li>
                        @*<li class="nav-item">
                                <a class="nav-link" href="ApplySevices"><i class="bi bi-arrow-down-circle-fill"></i> Apply Services</a>
                            </li>*@

                        <li class="nav-item">
                            <a class="nav-link" href="/User/Feedback"><i class="bi bi-chat-left-dots-fill"></i> Feedback</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/User/MyProfile"><i class="bi bi-bag"></i> My Profile</a>
                        </li>

                        <!-- Dropdown -->
                        @*<li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbardrop" data-toggle="dropdown">
                                    <i class="bi bi-gear"></i> Setting
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" href="/User/MyProfile"><i class="bi bi-pencil"></i> My Profile</a>
                                    <a class="dropdown-item" href="/User/ChangePassword"><i class="bi bi-key"></i> Change Password</a>
                                    <a class="dropdown-item" href="/User/LogOut"><i class="bi bi-box-arrow-right"></i> Logout</a>
                                </div>
                            </li>*@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle second-text fw-bold" href="#" id="navbarDropdown"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user me-2"></i>Setting
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li><a class="dropdown-item" href="MyProfile">Profile</a></li>
                                <li><a class="dropdown-item" href="ChangePassword">Change Password</a></li>
                                <li><a class="dropdown-item" href="LogOut">LogOut</a></li>
                            </ul>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
    <!--Render body-->

    @RenderBody()

    <!--Render body end-->
    <!-- Footer Start -->
    <div class="container-fluid">
        <div class="row bg-dark text-center text-white">
            <div class="col-sm-6" style="padding:5px">
                <span class="text-light">
                    <a href="https://mykss.in/" class="text-white" style="text-decoration:none"><i class="fas fa-copyright text-white me-2"></i> mykss.in</a> &emsp; All Right Reserved - <span>
                        <script type="text/javascript">var year = new Date(); document.write(year.getFullYear());</script>
                    </span>
                </span>
            </div>
            <div class="col-sm-6" style="padding:5px"><span class="text-light">Developed By &nbsp;<a href="/General/Developer" class="text-secondary">Tech Titans Teams</a> Distributed By &nbsp;<a href="/General/Developer">Softech Spire</a></span>
            </div>
        </div>
    </div>
    <!-- Footer End -->
</body>
</html>