    }

    .footer {
        float: right;
        margin: 28px 0 0 18px;
        font-size: 13px;
        color: #636363;
    }

    .by-name {
        font-weight: 700;
    }

    .Vidio-section {
        box-shadow: 0 7px 30px -10px rgba(150,170,180,0.5);
    }

    .vidio-section2 {
        box-shadow: 0px 1px 0px 0px rgba(27, 31, 36, 0.04);
