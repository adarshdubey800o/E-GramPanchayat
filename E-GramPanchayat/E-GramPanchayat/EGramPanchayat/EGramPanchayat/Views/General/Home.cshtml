@*//To save Enquiry using Ajax*@
<script>
    $(document).ready(function () {
        $("#btnsubmit").click(function () {
            //debugger;
            var name, email, mob, topic, subject;
            name = $("#tname").val();
            email = $("#temail").val();
            mob = $("#tmobile").val();
            topic = $("#ttopic").val();
            subject = $("#tmessage").val();
            var obj = { Name: name, EmailId: email, MobNo: mob, Topic: topic, Enquiry_Msg: subject }
            $.getJSON('/General/SaveEnquiry', obj, function (result) {
                if (result == "SUCCESS") {
                    alert("Enquiry save successfully");
                    $("#btnclose").trigger("click");
                    $("#tname").val(" ");
                    $("#temail").val(" ");
                    $("#tmobile").val("");
                    $("#ttopic").val(" ");
                    $("#tmessage").val(" ");
                }
                else {
                    alert("Sorry! your enquiry is not saved");
                }

            })
        })
    })
</script>
<script>
