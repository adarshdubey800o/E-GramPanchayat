        display:flex;
        flex-direction:row;
        justify-content:center;
    }
        #photo-section h5, a {
            margin-left: 2rem;
            font-size: 1.5rem;
            text-decoration: none;
            background: #383b3a;
            text-align:center;
            border-radius:1.5rem;
        }*/

    #photo-section:hover {
        box-shadow: rgba(0, 0, 0, 0.19) 0px 10px 20px, rgba(0, 0, 0, 0.23) 0px 6px 6px;
    }

    /*Button section start*/

    button {
        padding: 12.5px 30px;
        border: 0;
        border-radius: 100px;
        background-color: #2ba8fb;
        color: #ffffff;
        font-weight: Bold;
        transition: all 0.5s;
        text-align: center;
        margin-top: 1rem;
        -webkit-transition: all 0.5s;
    }

        button a {
            text-decoration: none;
        }

        button:hover {
            background-color: #FDA12B;
            box-shadow: 0 0 10px #6fc5ff50;
            transform: scale(1.1);
        }

        button:active {
            background-color: #3d94cf;
            transition: all 0.25s;
            -webkit-transition: all 0.25s;
            box-shadow: none;
            transform: scale(0.98);
        }
    /*Enquiry CSS*/
    #btnenq {
        position: fixed;
        bottom: 450px;
        offset-rotate: reverse;
        right: 1px;
        z-index: 9;
        margin-right: 0px;
    }

    .err {
        color: red;
    }

    .btn:hover {
        color: black;
        background-color: coral;
        box-shadow: 10px;
    }

    .fts {
        font-family: 'Times New Roman';
    }
</style>

