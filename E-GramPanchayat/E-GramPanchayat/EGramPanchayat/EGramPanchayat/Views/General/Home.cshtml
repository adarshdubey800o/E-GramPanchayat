
@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/General_Layout.cshtml";
}
@using EGramPanchayat.Models
@model IEnumerable<Notification_Master>
<style>
    * {
        margin: 0px;
        padding: 0px;
        background: border-box;
        scroll-behavior: smooth;
    }

    body {
        font-family: 'poppins',sans-serif;
        overflow-x: hidden;
    }
    /*Corosol section start*/
    /*Corosol section start*/

    .carousel-item {
        position: relative;
    }

        .carousel-item::after {
            content: "";
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
        }

    .carousel-caption {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1;
    }



    .carousel-control-prev {
        width: 90px;
        height: 60px;
        position: absolute;
        top: 50%;
        left: 0;
        background: var(--bs-info);
        border-radius: 0 50px 50px 0;
        opacity: 1;
    }

        .carousel-control-prev:hover {
            background: var(--bs-secondary);
            transition: .8s;
        }

    .carousel-control-next {
        width: 90px;
        height: 60px;
        position: absolute;
        top: 50%;
        right: 0;
        background: var(--bs-info);
        border-radius: 50px 0 0 50px;
        opacity: 1;
    }

        .carousel-control-next:hover {
            background: var(--bs-secondary);
            transition: .8s;
        }

    .carousel-caption .carousel-content a button.carousel-content-btn1 {
        background: var(--bs-secondary);
        color: var(--bs-dark);
        opacity: 1;
        border: 0;
        border-radius: 20px;
    }

        .carousel-caption .carousel-content a button.carousel-content-btn1:hover {
            background: var(--bs-primary);
            color: #ffffff;
            border: 0;
            opacity: 1;
            transition: 1s;
            border-radius: 20px;
        }

    .carousel-caption .carousel-content a button.carousel-content-btn2 {
        background: var(--bs-primary);
        color: var(--bs-white);
        opacity: 1;
        border: 0;
        border-radius: 20px;
    }

        .carousel-caption .carousel-content a button.carousel-content-btn2:hover {
            background: var(--bs-secondary);
            color: var(--bs-dark);
            border: 0;
            opacity: 1;
            transition: 1s;
            border-radius: 20px;
        }
    /*Corosol section end*/

    button {
        --primary-color: #FDA12B;
        --secondary-color: #fff;
        --hover-color: #111;
        --arrow-width: 10px;
        --arrow-stroke: 2px;
        box-sizing: border-box;
        border: 0;
        border-radius: 100px;
        color: var(--secondary-color);
        padding: 1em 1.8em;
        margin-bottom: 1em;
        background: var(--primary-color);
        display: flex;
        transition: 0.2s background;
        align-items: center;
        gap: 0.6em;
        font-weight: bold;
    }

        button .arrow-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        button .arrow {
            margin-top: 1px;
            width: var(--arrow-width);
            background: var(--primary-color);
            height: var(--arrow-stroke);
            position: relative;
            transition: 0.2s;
        }

            button .arrow::before {
                content: "";
                box-sizing: border-box;
                position: absolute;
                border: solid var(--secondary-color);
                border-width: 0 var(--arrow-stroke) var(--arrow-stroke) 0;
                display: inline-block;
                top: -3px;
                right: 3px;
                transition: 0.2s;
                padding: 3px;
                transform: rotate(-45deg);
            }

        button:hover {
            background-color: var(--hover-color);
        }

            button:hover .arrow {
                background: var(--secondary-color);
            }

                button:hover .arrow:before {
                    right: 0;
                }


    .card {
        box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 12px;
    }

    /* Schme Card title*/
    .card-section {
        box-sizing: border-box;
        width: 190px;
        height: 220px;
        background: rgba(217, 217, 217, 0.58);
        border: 1px solid white;
        box-shadow: 12px 17px 51px rgba(0, 0, 0, 0.22);
        backdrop-filter: blur(6px);
        border-radius: 17px;
        text-align: center;
        cursor: pointer;
        transition: all 0.5s;
        user-select: none;
        font-weight: bolder;
        color: black;
        letter-spacing: 2;
    }

        .card-section:hover {
            border: 1px solid black;
            transform: scale(1.05);
        }

        .card-section:active {
            transform: scale(0.95) rotateZ(1.7deg);
        }

    /*Scheme Card Title End*/
    #Scheme-section1 {
        background-color: #FBAB7E;
        background-image: linear-gradient(62deg, #FBAB7E 0%, #F7CE68 100%);
    }



    .rainbow {
        background-color: black;
        font-family: 'Times New Roman';
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-align: center;
    }


    .galary-section:hover {
        box-shadow: rgb(38, 57, 77) 0px 20px 30px -10px;
        box-shadow: rgba(0, 0, 0, 0.4) 0px 2px 4px, rgba(0, 0, 0, 0.3) 0px 7px 13px -3px, rgba(0, 0, 0, 0.2) 0px -3px 0px inset;
    }

    /*Image Galary Section*/

