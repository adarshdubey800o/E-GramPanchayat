
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/General_Layout.cshtml";
}
<style>
    .err {
        color: red;
    }
    #log {
        margin-top: 50px;
        background-color: lightseagreen;
        background-size: cover;
        border-radius: 8px;
        background-image: linear-gradient(0deg, #FFDEE9 0%, #B5FFFC 100%);
        border: 4px solid aqua;
    }
</style>
<div class="container-fluid">
    <div class="row">
        <div class="col-sm-1"></div>
        <div class="col-sm-10 pb-5">
            <div class="row">
                <div class="col-sm-5">
                    <img src="~/Content/Images/jjj.png" style="height:450px;margin-top:50px;">
                </div>
                <div class="col-sm-2"></div>
                <div class="col-sm-5" id="log"/>
                <form action="/General/Login" method="post">
                    <div class="mb-3 mt-2">
                        <p id="presponse" class="bg-white text-danger  text-center h4" style=" min-height:40px; padding:10px;display:none;">@ViewBag.Result</p>
                        <h2 style="  text-align: center; font-weight: bold; margin-bottom:40px;">Login Here</h2>
                        <select id="menu" class="form-select" name="UserType">
                            <option value=""> Select User Type</option>
                            <option value="BENEFICIERY">Beneficiary</option>
                            <option value="ADMIN">Admin</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="exampleInputEmail1" class="form-label"><b>Email address</b></label>
                        <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Enter your email" name="UserId">
                    </div>
                    <div class="mb-5">
                        <label for="exampleInputPassword1" class="form-label"><b>Password</b></label>
                        <input type="password" class="form-control" id="Passwaord" placeholder="Enter your password" name="Pass">
                    </div>
                    <input type="submit" value="Login" class="btn btn-primary" id="btn" style=" width:100px; margin-bottom:40px;" />
                    <!-- Button trigger modal -->
                    @*<a href="" class="text-danger" style="">Forgot Password</a>*@
                    @*<a>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal" style="margin-bottom: 40px;" id="btn">
                                Forget Password
                            </button>
                        </a>*@

                    <!-- Button trigger modal -->
                    <!-- Modal -->
                    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content" style="background-image: linear-gradient(0deg, #FFDEE9 0%, #B5FFFC 100%);">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLabel">RE-GENERATE YOUR PASSWORD</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">

                                    <div class="mb-3">
                                        <label for="exampleInputEmail1" class="form-label">Email address</label>
                                        <input type="email" class="form-control" id="Email" aria-describedby="emailHelp" placeholder="Enter your email">
                                    </div>
                                    <div class="mb-3">
                                        <label for="exampleInputPassword1" class="form-label">New Password</label>
                                        <input type="password" class="form-control" id="Pass" placeholder="Enter your password">
                                    </div>
                                    <div class="mb-3">
                                        <label for="exampleInputPassword1" class="form-label">Confirm Password</label>
                                        <input type="password" class="form-control" id="CPassword" placeholder="Enter your password again">
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    <button type="submit" id="savechange" class="btn" style="background-color: #e3aa86;">Save changes</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
                </div>
            </div>
        </div>
        <div class="col-sm-1"></div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $("#btn").click(function () {
            var select, email, password, status = true;
            select = $("#menu").val().trim();
            email = $("#exampleInputEmail1").val().trim();
            password = $("#Passwaord").val().trim();
            $(".err").remove();

            // validate user
            if (select.length == 0) {
                status = false;
                $("#menu").after("<span class='err'>Please enter your user type.</span>")
            }
            //validate email;
            if (email.length == 0) {
                status = false;
                $("#exampleInputEmail1").after("<span class='err'>Please enter your email.</span>")
            }
            // validate password;
            if (password.length == 0) {
                status = false;
                $("#Passwaord").after("<span class='err'>Please enter your password.</span>")
            }
            else if (password.length < 6) {
                status = false;
                $("#Passwaord").after("<span class='err'>Please enter valid  password.</span>")
            }

            return status;
        });
    });

