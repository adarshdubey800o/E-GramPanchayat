
@{
    ViewBag.Title = "ApplySevices";
    Layout = "~/Views/Shared/User_Layout.cshtml";
}
@using EGramPanchayat.Models
@model IEnumerable<Apply_Master>

<style>
    .registration__field {
        padding: 20px 0px;
        position: relative;
        padding-left: 30px;
    }
    .registration__input {
        border: none;
        border-bottom: 2px solid #D1D1D4;
        background: none;
        padding: 10px;
        padding-left: 24px;
        font-weight: 700;
        width: 75%;
        transition: .2s;
    }
    .registration__submit {
        background: #fff;
        font-size: 14px;
        margin-top: 30px;
        padding: 16px 20px;
        margin-bottom: 30px;
        border-radius: 26px;
        border: 1px solid #D4D3E8;
        text-transform: uppercase;
        font-weight: 700;
        display: flex;
        align-items: center;
        width: 50%;
        color: #4C489D;
        box-shadow: 0px 2px 2px #5C5696;
        cursor: pointer;
        transition: .2s;
    }
    .button__icon {
        font-size: 24px;
        margin-left: auto;
        color: #7875B5;
    }

    .err {
        color: red;
    }
</style>

<div class="row pb-5 mt-5">
    <div class="col-sm-1"></div>
    <div class="col-sm-6" style="box-shadow: 0px 0px 4px 2px gray; height:70%;">
        <img src="~/Content/Images/reg.jpg" style="width:100%; height:532px;" />
    </div>
    <div class="col-sm-4" style="box-shadow: 0px 0px 4px 2px gray;padding-right:20px;height:70%;">
        <form action="/User/ApplySevices" method="post">
            <div class="row">
                <h2 style="text-align: center; padding-top: 20px; font-weight: bold; color: black;">Apply Service</h2>
            </div>
            <h3  id="msgs"style="background-color:antiquewhite">@ViewBag.res</h3>
            
            <div class="registration__field">
                <input type="text" class="registration__input" placeholder="Name.." id="Name" name="Name">
            </div>
            <div class="registration__field">
                <input type="email" class="registration__input" placeholder="Email" id="Email" name="Email">
            </div>
            <div class="registration__field">
                <input type="number" class="registration__input" placeholder="Mobile No." id="Mobile" name="MobileNo">
            </div>
            <div class="registration__field">
                <select id="Services" name="Services" class="registration__input">
                    <option style="color:gray;">@ViewBag.Services</option>
                </select>
            </div>
            <center>
                @*<butto class="button registration__submit" id="btn" style="padding-left: 30px;">
                        <span class="button__text"> Apply Now</span>
                        <i class="button__icon fas fa-chevron-right"></i>
                    </butto>*@
                <input type="submit" class="registration__submit" id="btn" value="Apply Now" style="padding-left: 30px; " />
            </center>
        </form>
    </div>
    <div class="col-sm-1"></div>
</div>

<script> 
    $(document).ready(function () {
        var msg = $("#msgs").text().trim();
        if (msg.length > 0) {
            $("#msgs").slideDown(1000).delay(5000).slideUp(3000);
        }
        $("#btn").click(function () {
            var name, email, mobileno, state, status = true;
            name = $("#Name").val().trim();
            email = $("#Email").val().trim();
            mobileno = $("#Mobile").val().trim();
            state = $("#Services").val().trim();
            $(".err").remove();

            //validate name;
            if (name.length == 0) {
                status = false;
                $("#Name").after("<br><span class='err'> Please enter name .</span>")
            }
            else if (name.length < 2) {
                status = false;
                $("#Name").after("<br><span class='err'>Please enter your valid name.</span>")
            }
            else if (!/^[A-Za-z\s\-]+$/.test(name)) {
                status = false;
                $("#Name").after("<br><span class='err'>Please enter a valid name without numbers or special characters.</span>");
            }
            else if (name.length < 2) {
                status = false;
                $("#Name").after("<br><span class='err'>Please enter your valid name.</span>")
            }

            //validate email;
            if (email.length == 0) {
                status = false;
                $("#Email").after("<br><span class='err'>Please enter your valid email.</span>")
            }
            //validate mobileno;
            if (mobileno.length == 0) {
                status = false;
                $("#Mobile").after("<br><span class='err'>Please enter your Mobile no.</span>")
            }
            else if (mobileno.length !== 10) {
                status = false;
                $("#Mobile").after("<br><span class='err'>Please enter 10 digit mobile no.</span>")
            }

            // validate a select State;
            if (state.length == 0) {
                status = false;
                $("#Services").after("<br><span class='err'>Please select a State</span>")
            }
            return status;
        });

    });
</script>
@{
    if (IsPost)
    {
        <script>
            if (window.history.replaceState) {
                window.history.replaceState(null, null, window.location.href);
            }
        </script>
    }
}