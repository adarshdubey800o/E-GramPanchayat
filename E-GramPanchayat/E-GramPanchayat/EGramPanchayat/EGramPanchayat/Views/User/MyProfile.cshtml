@{
    ViewBag.Title = "MyProfile";
    Layout = "~/Views/Shared/User_Layout.cshtml";
}
@using EGramPanchayat.Models
@model BeneficiaryMaster
<style>
    .controls.form-control {
        margin-top: 15px;
        margin-bottom: 10px;
    }
    .err {
        color: red;
    }
    #main {
        box-shadow: 0 4px 8px 0 rgba(185, 92, 92, 0.2), 0 6px 20px 0 rgba(232, 14, 14, 0.19);
        border-radius: 8px;
        background-image: linear-gradient(to right, rgb(233, 207, 9), rgb(244, 244, 173),orange);
    }
</style>
<script>
    $(document).ready(function () {
        var msg = $("#msg").text().trim();
        if (msg.length > 0) {
            $("#msg").slideDown(1000).delay(5000).slideUp(3000);
        }
    });
</script>

<form action="/User/MyProfile" method="post" enctype="multipart/form-data">
    <div class="container-fluid">
        <div class="row pt-2">
            <div class="col-sm-1"></div>
            <div class="col-sm-10 my-5" id="main">
                <h1 style="text-align: center;text-shadow: 1px 2px #eca605; ">My Profile</h1><hr>
                 <h4 id="msg" style="background-color:antiquewhite;text-align:center;">@TempData["Message"]</h4>
                <div class="row">
                    <!--Profile-->
                    <div class="col-sm-4">
                        <div class="row">
                            <div class="col-sm-2"></div>
                            <div class="col-sm-8">
                                <img src="~/Content/BeneficiaryPic/@Model.BeneficiaryPicName" class="rounded-circle" alt="Cinque Terre" height="140" width="140" style="border-radius:50%; margin-left:20px;">
                                <input type="file" name="UserImg" id="file" style="padding-top: 15px;" />
                            </div>
                            <div class="col-sm-2"></div>
                        </div>
                        <div class="row ">
                            <div class="col-sm-2"></div>
                            <div class="col-sm-8 p-3">
                                <img src="~/Content/AdharPic/@Model.AdharPicName" class="rounded" alt="Cinque Terre" height="180" width="250">
                                <input type="file" placeholder="Change Profile" name="AdharImg" id="file" style="padding-top: 15px;" />
                            </div>
                            <div class="col-sm-2"></div>
                        </div>

                    </div>
                    <!--Menu-->
                    <div class="col-sm-8">
                        <div class="row controls">
                            <div class="col-sm-6 my-3">
                                <input type="text" id="Name" name="Name" value="@Model.Name" class="form-control" />
                            </div>

                            <div class="col-sm-6 my-3">
                                @if (Model.Gender == "Male")
                                {
                                    <span class="form-control">
                                        Gender: &nbsp;&nbsp;&nbsp;  &nbsp;&nbsp;&nbsp;<input type="radio" name="Gender" value="Male" id="fmale" checked />Male
                                        &nbsp;&nbsp;&nbsp;  &nbsp;&nbsp;&nbsp;<input type="radio" name="Gender" value="Male" id="ffemale" />Female

                                    </span>
                                }
                                else
                                {
                                    <span class="form-control">
                                        Gender: &nbsp;&nbsp;&nbsp;  &nbsp;&nbsp;&nbsp;<input type="radio" name="Gender" value="Male" id="fmale" />Male &nbsp;&nbsp;&nbsp;  &nbsp;&nbsp;&nbsp;<input type="radio" name="Gender" value="Male" id="ffemale" checked />FeMale

                                    </span>
                                }
                            </div>
                        </div>
                        <div class="row controls">
                            <div class="col-sm-6 my-3">
                                <input type="text" id="FatherName" name="FatherName" value="@Model.FatherName" class="form-control" />
                            </div>
                            <div class="col-sm-6 my-3">
                                <input type="number" id="Mobile" name="MobileNo" value="@Model.MobileNo" class="form-control" />
                            </div>
                        </div>
                        <div class="row controls">
                            <div class="col-sm-6 my-3">
                                <input type="email" id="Email" name="EmailId" value="@Model.EmailId" class="form-control" />
                            </div>
                            <div class="col-sm-6 my-3">
                                <input type="number" id="AdharNo" name="AdharNo" value="@Model.AdharNo" class="form-control" />
                            </div>
                        </div>
                        <div class="row controls">

                            <div class="col-sm-6 my-3">
                                <select name="StateId" id="State" class="form-control">
                                    <option value="">@Model.State_Master.StateName</option>
                                </select>


                            </div>

                            <div class="col-sm-6 my-3">
                                <select name="CityId" id="City" class="form-control">
                                    <option value="">@Model.City_Master.CityName</option>
                                </select>
                            </div>

                        </div>
                        <div class="row controls">
                            @*<div class="col-sm-6 my-3">
                                <select name="RelatedBlockId" id="Block" class="form-control">
                                    <option value="">@Model.Block_Master.BlockName</option>
                                </select>
                            </div>
                            *@
                            <div class="col-sm-6 my-3">
                                <input type="text" id="Village" name="VillageName" value="@Model.VillageName" class="form-control" />
                            </div>
                        </div>
                        <div class="row controls">
                            <div class="col-sm-6 my-3">
                                <textarea id="Address" class="form-control" name="Address">@Model.Address</textarea>

                            </div>
                            <div class="col-sm-6 my-3">

                                <input type="number" id="PinCode" name="PinCode" value="@Model.PinCode" class="form-control" />

                            </div>
                        </div>
                        <div class="row controls">
                            <div class="col-sm-4 my-3"></div>
                            <div class="col-sm-4 my-3">
                                <input type="submit" name="BtnChange" id="Btn" class="btn btn-success btn-block" value="Save Changes" />
                            </div>

                            <div class="col-sm-4 my-3"></div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="col-sm-1"></div>
        </div>
    </div>
</form>