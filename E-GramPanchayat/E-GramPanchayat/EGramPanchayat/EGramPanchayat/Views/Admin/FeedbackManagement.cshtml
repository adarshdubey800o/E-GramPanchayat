
@{
    ViewBag.Title = "FeedbackManagement";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}
@using EGramPanchayat.Models
@model IEnumerable<Feedback_Master>
    <div class="container-fluid">
<div class="row">
    <div class="col-sm-12">
        <table class="table table-hover table-bordered">
            <thead>
                <tr class="table-primary" align="center">
                    <th scope="col">FeedbackId</th>
                    <th scope="col">FeedbackTitle</th>
                    <th scope="col">Description</th>
                    <th scope="col">UserId</th>
                    <th scope="col">Feedback_DT</th>

                </tr>
            </thead>
            <tbody>
                @{
                    foreach (Feedback_Master f in Model)
                    {
                        <tr>

                            <td>@f.FeedbackId</td>
                            <td>@f.FeedbackTitle</td>
                            <td>@f.Description</td>
                            <td>@f.UserId</td>
                            <td>@f.Feedback_DT</td>

                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
        </div>
