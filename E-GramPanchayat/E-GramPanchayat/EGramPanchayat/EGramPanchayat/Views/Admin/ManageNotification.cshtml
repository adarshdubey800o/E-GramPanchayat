
@{
    ViewBag.Title = "ManageNotification";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}

@using EGramPanchayat.Models
@model IEnumerable<Notification_Master>

<div class="row">
    <div class="col-sm-12">
        <h1 class="text-center text-center" style="margin:20px;padding:10px; text-decoration:underline;">Manage News and Updates</h1>
        <p id="presponse" class="bg-warning text-danger text-center h4"
           style="min-height:40px;width:100%;padding:10px;display:none;">@ViewBag.msg</p>
        <div class="row">
            <div class="col-sm-12">
                <table class="table table-hover table-bordered table table-striped">
                    <thead>
                        <tr>
                           
                            <td colspan="5" style="text-align:center"><a href="Notification" class="btn btn-block btn-outline-warning text-white bg-warning" ><b>Add New Update</b></a></td>
                        </tr>
                        <tr class="table-primary" align="center">
                            <th scope="col">ID</th>
                            <th scope="col">Message</th>
                            <th scope="col">Date</th>
                            <th scope="col">Update</th>
                            <th scope="col">Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            foreach (Notification_Master e in Model)
                            {
                                <tr>

                                    <td>@e.Nid</td>
                                    <td>@e.NMsg</td>
                                    <td>@e.NDT</td>
                                    <td>@Html.ActionLink("Update", "UpdateNotification", new { @id = e.Nid }, new { @class = "btn btn-block btn-primary" })</td>
                                    <td>@Html.ActionLink("Delete", "DeleteNotification", new { @id = e.Nid }, new { @class = "btn btn-block btn-danger" })</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>