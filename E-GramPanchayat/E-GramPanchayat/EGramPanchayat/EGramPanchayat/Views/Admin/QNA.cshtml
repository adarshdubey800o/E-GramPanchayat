
@{
    ViewBag.Title = "QNA";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}

<script src="~/Content/js/qna.js"></script>
<script src="~/Content/js/ASPSnippets_Pager.min.js"></script>

<style>
    .inner-main_gry_bg.ptb .main_gry_bg {
        border-radius: 0;
        margin-top: 0;
        width: 95%;
        margin: 0 auto;
        box-shadow: 0 1px 11px #dcdcdc;
        position: absolute;
        left: 0;
        right: 0;
        padding-bottom: 40px;
    }

    .rq {
        font-size: 22px;
        top: -6px;
    }

    .main_gry_bg_list {
        border: none;
        background: #fff;
        border-radius: 5px;
        width: 98%;
        margin-top: 35px !important;
        margin-left: 1%;
    }

    #ddlPageSize {
        padding-top: 0px;
    }
    /*----------------------------------paging------------------------------------*/
    .Pager span {
        min-width: 35px;
        height: 33px;
        padding: 5px 5px;
        -webkit-border-radius: 5px;
        text-align: center;
        color: #000;
        display: inline-block;
        background-color: #E0F2F1;
        margin-right: 3px;
        line-height: 150%;
        border: 1px solid #3AC0F2;
    }

    .Pager a {
        min-width: 35px;
        height: 33px;
        padding: 5px 5px;
        -webkit-border-radius: 5px;
        text-align: center;
        display: inline-block;
        background-color: #fff !important;
        color: #000;
        border: 1px solid #3AC0F2 !important;
        margin: 0 3px;
        line-height: 150%;
        text-decoration: none;
    }
</style>


<div class="main_gry_bg ptb">
    <div class="row">
        <div class="col-md-12">
            <h2>
                <span class="rq">Manage Page Schema</span>
            </h2>
            <hr class="hr_5" />

            <div class="box-body">
                <div class="col-sm-12">
                    <div class="row">
                        <div class="col-sm-2">
                            <input type="hidden" id="AutoId" name="AutoId" class="form-control">
                        </div>
                    </div>
                    <div class="row form-group" style="margin-top: 8px;">
                        <div class="col-sm-2">
                            <label>URL: <span class="required"></span></label>
                        </div>
                        <div class="col-sm-4">
                            <input type="text" class="form-control border-primary req" id="txtUrl" placeholder="http:/www.example.com">
                        </div>

                        <div class="col-sm-2">
                            <label>Status:<span class="required"> </span></label>
                        </div>
                        <div class="col-sm-4">
                            <select class="form-control border-primary req" id="ddlStatus">
                                <option value="" selected="selected">select..</option>
                                <option value="1">Active</option>
                                <option value="0">Inactive</option>
                            </select>
                        </div>

                    </div>
                    <div class="row form-group" style="margin-top: 8px;">
                        <div class="col-sm-2">
                            <label>Question:<span class="required"> </span></label>
                        </div>
                        <div class="col-sm-4">
                            <textarea class="form-control border-primary input-sm req" id="txtQuestion" style="padding: 4px" maxlength="500"></textarea>
                        </div>
                        <div class="col-sm-2">
                            <label>Answer:<span class="required"> </span></label>
                        </div>
                        <div class="col-sm-4">
                            <textarea class="form-control border-primary input-sm req" id="txtAnswer" style="padding: 4px"></textarea>
                        </div>

                    </div>

                </div>
            </div>

            <div class="col-md-12">
                <ul class="list-inline" style="margin-top: 12px; margin-bottom: 15px;">
                    <li>
                        <button type="button" onclick="Save_data()" id="btnsave" class="btn btn-primary btn-save-new" style="margin: 0 auto; background-color: #e5a54b;">Save</button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="main_gry_bg_list">
    <div class="col-md-12">
        <h4>Manage Page List</h4>
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover" id="tblFBS">
                <thead>
                    <tr>
                        <th class="Id text-center">S.No</th>
                        <th class="Url text-center">URL</th>
                        <th class="Question text-center">Question</th>
                        <th class="Answer text-center">Answer</th>
                        <th class="Status text-center">Status</th>
                        <th class="CreatedBy text-center">CreatedBy</th>
                        <th class="action text-center" style="width: 10%">Action</th>
                    </tr>
                </thead>
                <tbody id="tblData">
                </tbody>
            </table>
            <h5 class="well text-center" id="EmptyTable" style="display: none">No data available.</h5>
        </div>

        <div class="form-group row" id="DivPager">
            <div class="col-md-1">
                <select class="form-control border-primary input-sm" id="ddlPageSize" onchange="getQNADetail(1)">
                    <option value="10">10</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="500">500</option>
                    <option value="1000">1000</option>
                    <option value="0">All</option>
                </select>
            </div>
            <div class="col-md-11" style="display: flex; justify-content: flex-end;">
                <div class="Pager" id="Pager"></div>
            </div>
        </div>

    </div>
</div>

