            </div>
            <div class="col-sm-2"></div>
        </div>

        
        <!--Slider.-->
        <div class="scroll-container " style="margin-top:15px;">
            <img src="~/Content/Images/HOME.jpg" alt="Cinque Terre" width="600" height="400">
            <img src="~/Content/Images/Img 11.jpg" alt="Forest" width="600" height="400">
            <img src="~/Content/Images/IMG AG1.jpg" alt="Northern Lights" width="600" height="400">
            <img src="~/Content/Images/SCHOOL.jpg" alt="Mountains" width="600" height="400">
            <img src="~/Content/Images/WATER3.jpg" alt="Cinque Terre" width="600" height="400">
            <img src="~/Content/Images/SM1074941.jpg" alt="Forest" width="600" height="400">
            <img src="~/Content/Images/IMG AG5.jpg" alt="Northern Lights" width="600" height="400">
            <img src="~/Content/Images/SCHOOL5.jpg" alt="Mountains" width="600" height="400">
        </div>


</div>
