                        <p class="card-text">Jal Jeevan Mission, is envisioned to provide safe and adequate drinking water.</p>
                        <a href="/General/Services1"><input style="background-color: rgb(3, 201, 250);color:white;height: 35px;width: 140px;border: none;border-radius: 5px;font-weight:500;" type="button" value="Visit"  /></a>

                    </div>
                </div>
            </div>
            <div class="col-sm-2 styup">
                <div class="card w-100 styup1" style="width: 18rem;">
                    <img src="~/Content/Images/Aayushman-Bharat-Yojana.png" class="card-img-top" alt="...">
                    <div class="card-body">
                        <h5 class="card-title clrC text-center" style="font-family:Algerian">AYUSHMAN Bharat</h5>
