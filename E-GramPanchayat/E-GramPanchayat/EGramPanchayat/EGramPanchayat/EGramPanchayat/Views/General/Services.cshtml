                        <a href="/General/Services2"> <input style="background-color: rgb(3, 201, 250);color:white;height: 35px;width: 140px;border: none;border-radius: 5px;font-weight:500;" type="button" value="Visit"  /></a>
                    </div>
                </div>
            </div>
            <div class="col-sm-2 styup">
                <div class="card w-100 styup1" style="width: 18rem;">
                    <img src="~/Content/Images/SCHOOL7.jpg" class="card-img-top" alt="...">
                    <div class="card-body">
                        <h5 class="card-title clrC text-center" style="font-family:Algerian">School</h5>
                        <p class="card-text">Sarva Shiksha Abhiyan, or SSA, is an Indian Government programme aimed .</p>
                        <a href="/General/Services3">
                            <input style="background-color: rgb(3, 201, 250);color:white;height: 35px;width: 145px;border: none;border-radius: 5px;font-weight:500;" type="button" value="Visit"
                                   />
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-sm-2 styup">
                <div class="card w-100 styup1" style="width: 18rem;">
                    <img src="~/Content/Images/HOME.jpg" class="card-img-top" alt="...">
                    <div class="card-body">
                        <h5 class="card-title clrC text-center" style="font-family:Algerian">Awas Yojana</h5>
                        <p class="card-text">Pradhan Mantri Awas Yojana (Urban) Mission launched on 25th June 2015 . Indian Government.
                        </p>
                        <a href="/General/Services4">
                            <input style="background-color: rgb(3, 201, 250);color:white;height: 35px;width: 140px;border: none;border-radius: 5px;font-weight:500;" type="button" value="Visit"
                                    />
                        </a>
                    </div>
