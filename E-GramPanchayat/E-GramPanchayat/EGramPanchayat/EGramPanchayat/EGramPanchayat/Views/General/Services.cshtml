
@{
    ViewBag.Title = "Services";
    Layout = "~/Views/Shared/General_Layout.cshtml";
}

<style>
    #backimg {
        background-image: url('/Content/Images/Panchayati-Raj.jpg');
        background-size: 100% 100%;
        background-repeat: no-repeat;
        min-height: 500px;
    }

    #backimg1 {
        background-color: rgba(0, 0, 0, 0.646);
        color: white;
        min-height: 500px;
    }

    .clr {
        color: #FFC300;
    }

    .clrC {
        color: #FF5733;
    }

    .clr1 {
        background-color: #03bfff;
    }

    .styup {
        transform: translateY(-100px);
    }

        .styup:hover {
            transition-duration: 2s;
        }

    .styup1 {
        border: 0px solid white;
        box-shadow: 0px 0px 0px 2px rgb(215, 213, 213);
    }




    div.scroll-container {
        background-color: #333;
        overflow: auto;
        white-space: nowrap;
        padding: 10px;
    }

        div.scroll-container img {
            padding: 10px;
        }
</style>
<body>
    <div class="container-fluid p-0">
        <!-- // background-start -->
        <div class="row">
            <div class="col-sm-12" id="backimg">
                <div class="row pt-5" id="backimg1">
                    <div class="col-sm-3"></div>
                    <div class="col-sm-6" style="text-align: center;">
                        <span style="font-size: 5vh;font-weight: bold;">E Gram Panchayat...<br>“भारत सरकार  <span class="clr">दो भागों में विभाजित है स्थानीय सरकार और केंद्र सरकार। पंचायत स्थानीय सरकार का अंग है। पंचायती राज ग्रामीण स्तर पर सरकार है जो ग्रामीणों की सभी जरूरतों का ख्याल रखती है।”</span></span>

                    </div>
                    <div class="col-sm-3"></div>
                </div>
            </div>
        </div>
        <!-- background end  -->
        <!-- middle section vehicle Categories start -->
        <div class="row">
            <div class="col-sm-2"></div>
