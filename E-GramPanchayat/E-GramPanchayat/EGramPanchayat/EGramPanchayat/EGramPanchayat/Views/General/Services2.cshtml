
@{
    ViewBag.Title = "Services2";
    Layout = "~/Views/Shared/General_Layout.cshtml";
}

<style>
    #back {
        background-image: url('/Content/Images/Ayushnew.jpg');
        min-height: 400px;
        width: 100%;
        background-size: cover;
    }

    .card:hover {
        background-color: darkorange;
        transform: translateY(0px);
        box-shadow: 5px 5px 10px 1px rgba( 0, 0, 0, 0.496);
    }

    .card {
        transition-duration: 2.4s;
        transform: translateY(-30px);
        background-color: antiquewhite;
    }

    #content:hover {
        background-color: darkorange;
        transform: translateY(0px);
        box-shadow: 3px 3px 5px 1px rgba( 0, 0, 0, 0.496);
    }
</style>
<script>
    $(document).ready(function () {
        $(".san").fadeIn(3000);
        $("#img").fadeIn(5000);
    })
</script>
