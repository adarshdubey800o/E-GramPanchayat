        border-radius: 15px;
        outline: 0;
        padding: 7px;
        background-color: #fff;
        box-shadow: inset 1px 1px 5px #F39C12;
    }

    input#con_btnsave {
        width: 80%;
        padding: 7px;
        font-size: 16px;
        font-family: 'Times New Roman';
        font-weight: 600;
        border-radius: 15px;
        background-color: #F39C12;
        color: white;
        cursor: pointer;
        border: 1px solid rgba(0, 177, 106);
        box-shadow: 1px 1px 5px rgba(0,0,0,0.3);
        margin-bottom: 20px;
    }

    #con_btnsave:hover {
        background-color: forestgreen;
        color: black;
    }

    #con {
        text-align: center;
        width: 40%;
        border: 1px solid #ddd;
        border-radius: 15px;
        outline: 0;
        margin-left: 25px;
        padding: 5px;
        background-color: #fff;
        box-shadow: inset 1px 1px 5px #F39C12;
    }

    #con_img {
        margin-left: 20px;
    }
</style>
<script>

        $(document).ready(function () {
            $("#con_name").focus();
            $("#con_btnsave").click(function () {
                var status = true;
                //validation start
                var name, mob, email, message;
                name = $("#con_name").val().trim();
                email = $("#con_email").val().trim();
                mob = $("#con_mob").val().trim();
                message = $("#con_msg").val().trim();
                $(".err").remove();


                // validate name
                if (name.length == 0) {
                    $("#con_name").after("<span class='err'>Please enter your name</span>");
                    status = false;
                }
                else if (name.length < 3) {
                    $("#con_name").after("<span class='err'>Please enter your full name</span>");
                    status = false;
                }
                // validate email
                if (email.length == 0) {
                    $("#con_email").after("<span class='err'> Enter your email.</span>");
                    status = false;

                }


                // validate mobile number
                var regex = /^(0|91)?[6-9][0-9]{9}$/;
                if (mob.length == 0) {
                    $("#con_mob").after("<span class='err'>Please enter valid mobile number.</span>");
                    status = false;

                }
                else if (regex.test(mob) == false) {
                    $("#con_mob").after("<span class='err'> Invalid mobile number.</span>");
                    status = false;

                }
                //validate message
                if (message.length == 0) {
                    $("#con_msg").after("<span class='err'>Please enter your message.</span>");
                    status = false;
                }
                else {
                    var count = 1;
                    for (x = 0; x < message.length; x++) {
                        var ch = message.charAt(x);
                        if (ch == " " || ch == "." || ch == "," || ch == "!")
                            count++;

                    }
                    if (count < 3) {
                        $("#con_msg").after("<span class='err'>plese enter your complete message.</span>");
                        status = false;
                    }
                }
                return status;
            });
        });
</script>
